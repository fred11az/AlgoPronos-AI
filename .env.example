# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Redis Cache (Upstash — STRONGLY RECOMMENDED for <15s generation guarantee)
# Free tier: 10 000 req/day — https://console.upstash.com/
# Without Redis, the app falls back to Supabase-only caching (still works but slower)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI APIs
# ─── Venice AI (PRIMARY — required for AI-driven picks) ───────────────────────
# Privacy-first AI, no data retention. Get credits: https://venice.ai
# Models: llama-3.3-70b (default), deepseek-r1-671b (best reasoning), mistral-31-24b (fast)
VENICE_API_KEY=vn-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VENICE_MODEL=llama-3.3-70b

# Groq (fallback AI — free tier: 30 req/min)
# Get key: https://console.groq.com
GROQ_API_KEY=gsk_xxxx

# Gemini (legacy — kept for compatibility)
GEMINI_API_KEY=AIzaSy_xxxx

# API-Football v3 (REQUIRED for real match data)
# Provider: api-football.com / api-sports.io
# Get key: https://dashboard.api-football.com → Register → API Key
# Free tier: 100 req/day — Paid plans for more
API_FOOTBALL_KEY=

# The Odds API — Real bookmaker odds (RECOMMENDED, free tier: 500 credits/month)
# Get key: https://the-odds-api.com → "Get API Key"
# Used for: Premier League, LaLiga, Serie A, Bundesliga, Ligue 1, Champions League, Europa League
# Fallback: Gemini AI estimation for unmatched competitions
THE_ODDS_API_KEY=

# Resend (email transactionnel - REQUIRED)
# Get key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ─── Flux d'envoi séparés (cf. docs/EMAIL-DELIVERABILITY.md) ────────────────
# Deux domaines DISTINCTS vérifiés dans Resend. Les mélanger fait basculer les
# codes OTP en onglet Promotions : la réputation marketing contamine le reste.
#   - transactionnel : OTP, activation de compte, statut d'un dépôt/retrait
#     → suivi ouverture/clic À DÉSACTIVER sur ce domaine dans Resend
RESEND_TRANSACTIONAL_FROM=AlgoPronos AI <no-reply@algopronos.com>
#   - marketing : campagnes, invitations à l'upgrade (suivi autorisé)
RESEND_MARKETING_FROM=AlgoPronos AI <news@mail.algopronos.com>
# Ancienne variable unique — conservée en repli si les deux ci-dessus sont vides.
RESEND_FROM_EMAIL=AlgoPronos AI <no-reply@algopronos.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AlgoPronos AI

# IMPORTANT: SITE_URL must be the production domain (https://algopronos.ai or https://algopronos.com).
# DO NOT set this to your Vercel preview URL — it is used for email redirect links and
# auth callbacks. If wrong, email confirmation links will point to *.vercel.app instead
# of your real domain.
SITE_URL=https://algopronos.com

# Admin (comma-separated emails — REQUIRED for admin section to work)
# Example: ADMIN_EMAILS=you@example.com,partner@example.com
# If not set, all admin routes will return 403 Forbidden.
ADMIN_EMAILS=admin@algopronos.ai

# WhatsApp Business (Meta Cloud API — OPTIONAL)
# Setup: https://developers.facebook.com → WhatsApp Business API
# Templates à créer dans Meta Business Suite (langue: fr)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_TICKET=ticket_result
WHATSAPP_TEMPLATE_ACTIVATION=account_activated

# 1xBet Affiliate
NEXT_PUBLIC_1XBET_PROMO_CODE=AlgoPronos
NEXT_PUBLIC_1XBET_AFFILIATE_URL=https://refpa14435.com/L?tag=d_5346138m_1599c_&site=5346138&ad=1599

# AfroPari Affiliate
NEXT_PUBLIC_AFROPARI_AFFILIATE_URL=https://refpa84423.com/L?tag=d_5390010m_70055c_&site=5390010&ad=70055

# FedaPay (paiements mobile money — dépôts et virements)
# Dashboard: https://app.fedapay.com
# Compte: acc_4707515210
FEDAPAY_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
FEDAPAY_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
# Clé secrète pour vérifier les webhooks FedaPay (générer dans Dashboard > Webhooks)
FEDAPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_FEDAPAY_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx

# Emails de notification MobCash — séparés par des virgules pour plusieurs destinataires
# Ex: ADMIN_NOTIFICATION_EMAIL=admin1@gmail.com,admin2@gmail.com
ADMIN_NOTIFICATION_EMAIL=fgambakpo@gmail.com


# 1. Generate a key at https://www.indexnow.org/faq
# 2. Set INDEXNOW_KEY=<your-key> here
# 3. Create public/<your-key>.txt containing only the key value
# 4. Pages are auto-submitted to IndexNow after each pronostic generation
INDEXNOW_KEY=

# ─── Sales AI (Omari — commercial IA sur Facebook Messenger) ──────────────────
# Claude API (cerveau d'Omari) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxx
# Modèle utilisé pour les conversations (défaut: claude-sonnet-5)
OMARI_MODEL=claude-sonnet-5

# Meta Messenger — app Business sur https://developers.facebook.com
# 1. Créer une app Business + produit "Messenger"
# 2. Lier la page Facebook AlgoPronos → générer le Page Access Token
# 3. App Secret : paramètres de l'app
# 4. Verify Token : chaîne secrète inventée par nous (la même dans le dashboard Meta)
META_PAGE_ACCESS_TOKEN=EAAxxxx
META_APP_SECRET=xxxx
META_VERIFY_TOKEN=algopronos_webhook_secret
